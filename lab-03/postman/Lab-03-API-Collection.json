        {
          "name": "07. Test Limit and Offset (Pagination)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Returns exactly 3 books\", function () {",
                  "    var books = pm.response.json();",
