        {
          "name": "04. Search Using search_q (search_q=java)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All returned books contain search keyword in title\", function () {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.length).to.be.above(0);",
                  "    jsonData.forEach(function(book) {",
                  "        pm.expect(book.title.toLowerCase()).to.include('java');",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=java",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [{ "key": "search_q", "value": "java" }]
            },
            "description": "Searches books with partial title matching 'java'. Status 200 OK."
          }
        },
        {
          "name": "05. Sort by Price ASC",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Books are sorted in ascending price order\", function () {",
                  "    var books = pm.response.json();",
                  "    for (var i = 0; i < books.length - 1; i++) {",
                  "        pm.expect(books[i].price).to.be.at.most(books[i+1].price);",
                  "    }",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/books?order_by=price&order=ASC",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "ASC" }
              ]
            },
            "description": "Sorts books by price ascending. Status 200 OK."
          }
