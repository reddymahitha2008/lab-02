                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/books?limit=3&offset=2",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "limit", "value": "3" },
                { "key": "offset", "value": "2" }
              ]
            },
            "description": "Paginates: skips first 2 books and returns next 3 books. Status 200 OK."
          }
        },
        {
          "name": "08. Filter by min_price and max_price",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"All book prices are within 500 and 800\", function () {",
                  "    var books = pm.response.json();",
                  "    books.forEach(function(book) {",
                  "        pm.expect(book.price).to.be.at.least(500);",
                  "        pm.expect(book.price).to.be.at.most(800);",
                  "    });",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/books?min_price=500&max_price=800",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "min_price", "value": "500" },
                { "key": "max_price", "value": "800" }
              ]
            },
            "description": "Filters books with price between 500 and 800 inclusive. Status 200 OK."
          }
        },
        {
          "name": "09. Combine Search, Sorting, Pagination and Price Filter",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"Combined query executes successfully\", function () {",
                  "    var books = pm.response.json();",
                  "    pm.expect(books).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [{ "key": "Accept", "value": "application/json" }],
            "url": {
              "raw": "{{baseUrl}}/books?search_q=java&order_by=price&order=ASC&limit=5&offset=0&min_price=100&max_price=1000",
              "host": ["{{baseUrl}}"],
              "path": ["books"],
              "query": [
                { "key": "search_q", "value": "java" },
                { "key": "order_by", "value": "price" },
                { "key": "order", "value": "ASC" },
                { "key": "limit", "value": "5" },
                { "key": "offset", "value": "0" },
                { "key": "min_price", "value": "100" },
                { "key": "max_price", "value": "1000" }
              ]
            },
            "description": "Combines search, sorting, pagination, and price filter into one request. Status 200 OK."
          }
